{
  // IntelliSense を使用して利用可能な属性を学べます。
  // 既存の属性の説明をホバーして表示します。
  // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend (Vite Dev Server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": {
        "VITE_API_URL": "http://localhost:8000"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "password",
        "APP_NAME": "SelfOrWorld API",
        "APP_VERSION": "1.0.0",
        "DEBUG": "True",
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:3000",
        "SECRET_KEY": "dev-secret-key-change-in-production",
        "ALGORITHM": "HS256",
        "ACCESS_TOKEN_EXPIRE_MINUTES": "30"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Backend (FastAPI) - Neo4j Cloud",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "NEO4J_URI": "neo4j+s://your-instance.databases.neo4j.io",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "your-cloud-password",
        "NEO4J_DATABASE": "neo4j",
        "APP_NAME": "SelfOrWorld API",
        "APP_VERSION": "1.0.0",
        "DEBUG": "True",
        "CORS_ORIGINS": "http://localhost:5173,http://localhost:3000",
        "SECRET_KEY": "dev-secret-key-change-in-production",
        "ALGORITHM": "HS256",
        "ACCESS_TOKEN_EXPIRE_MINUTES": "30"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Local Neo4j)",
      "configurations": ["Backend (FastAPI)", "Frontend (Vite Dev Server)"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      }
    },
    {
      "name": "Full Stack (Neo4j Cloud)",
      "configurations": [
        "Backend (FastAPI) - Neo4j Cloud",
        "Frontend (Vite Dev Server)"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 2
      }
    }
  ]
}